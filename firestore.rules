rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read the full list of users to find people to chat with.
    // A user can only create or update their own user document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // A user can read or write a message if their UID is in the chat room ID.
    // The chatRoomId is a combination of two user UIDs, sorted alphabetically.
    match /messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid in request.resource.data.chatRoomId.split('_');
    }
  }
}
